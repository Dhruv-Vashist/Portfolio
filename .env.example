# ── Supabase (recommended) ─────────────────────────────────────────
# Supabase dashboard → Project Settings → API.
# Use the "anon / public" key. NEVER use the service_role key here.
# Leave both empty to run in local-only mode (localStorage + passcode).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: your owner email (extra UI check; the database enforces the real rule).
VITE_OWNER_EMAIL=

# ── Local-only mode (used only when Supabase is NOT configured) ────
VITE_ADMIN_PASSCODE=change-me

# ── Contact form (optional) ────────────────────────────────────────
# e.g. https://formspree.io/f/xxxxxxx — if empty, the form opens the visitor's email app.
VITE_FORMSPREE_ENDPOINT=
